# Copy this file to .env inside the functions/ folder before deploying.
# NEVER commit the real .env to git.

# From MSG91 Dashboard -> Authkey
MSG91_AUTH_KEY=your_msg91_auth_key_here

# Your verified WhatsApp number on MSG91 (with country code, no +)
MSG91_INTEGRATED_NUMBER=918105593259

# Template names as approved on the MSG91 dashboard
TEMPLATE_FEE_REMINDER=fee_reminder
TEMPLATE_FEE_REMINDER_EARLY=fee_reminder_early_offer
TEMPLATE_NOTICE=pg_notice
TEMPLATE_PRODUCT_PROMO=product_promo

# Template namespace (MSG91 dashboard -> WhatsApp -> your number -> namespace)
MSG91_TEMPLATE_NAMESPACE=your_template_namespace_here

# Payment link sent inside reminders (Razorpay payment page / UPI link etc.)
PAYMENT_LINK=https://rzp.io/l/your-pg-payment-page
