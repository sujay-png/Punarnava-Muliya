# Copy this file to .env inside the functions/ folder before deploying.
# NEVER commit the real .env to git.

# Meta WhatsApp Cloud API credentials
# From Meta for Developers -> WhatsApp -> API Setup
META_WA_PHONE_NUMBER_ID=your_phone_number_id_here

# Permanent System User Token from Meta Business Settings -> System Users
META_WA_ACCESS_TOKEN=your_permanent_access_token_here

# Template names as approved in WhatsApp Manager
TEMPLATE_FEE_REMINDER=fee_reminder
TEMPLATE_FEE_REMINDER_EARLY=fee_reminder_early_offer
TEMPLATE_NOTICE=notice
TEMPLATE_PRODUCT_PROMO=product_promo

# Payment link / UPI config
UPI_ID=gcmulia@kbl
UPI_PAYEE_NAME=PG Rent
