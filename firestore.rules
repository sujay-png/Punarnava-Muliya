rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() { 
      return request.auth != null && request.auth.token.email == 'gcmuliya@gmail.com'; 
    }

    match /tenants/{tenantId}      { allow read, write: if isOwner(); }
    match /payments/{paymentId}    { allow read, write: if isOwner(); }
    match /maintenance/{requestId} { allow read, write: if isOwner(); }
    match /products/{productId}    { allow read, write: if isOwner(); }
    
    match /stays/{stayId}          { allow read, write: if isOwner(); }
    match /deposits/{depositId}    { allow read, write: if isOwner(); }
    match /statusHistory/{id}      { allow read, write: if isOwner(); }

    match /notices/{noticeId} {
      allow read, create: if isOwner();
      allow update, delete: if false;
    }

    match /message_logs/{logId} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}