rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /tenants/{tenantId}      { allow read, write: if signedIn(); }
    match /payments/{paymentId}    { allow read, write: if signedIn(); }
    match /maintenance/{requestId} { allow read, write: if signedIn(); }
    match /products/{productId}    { allow read, write: if signedIn(); }

    match /notices/{noticeId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /message_logs/{logId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}